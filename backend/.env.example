APP_NAME=Resume Builder API
APP_VERSION=1.0.0
DEBUG=false

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resume_builder
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/resume_builder
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=change-this-to-a-secure-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
GEMINI_MAX_RETRIES=3
GEMINI_REQUEST_TIMEOUT=60

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=storage

MAX_UPLOAD_SIZE_MB=10
MAX_TEMPLATE_FILE_COUNT=50
MAX_RESUME_COUNT=100

CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

LOG_LEVEL=INFO

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

RATE_LIMIT_PER_MINUTE=60
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Uncomment for observability:
# SENTRY_DSN=
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=resume-builder
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Uncomment for S3 storage:
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_REGION=

# Uncomment for OAuth:
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# LINKEDIN_OAUTH_CLIENT_ID=
# LINKEDIN_OAUTH_CLIENT_SECRET=
